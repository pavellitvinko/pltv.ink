{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pltv-root",
  "main": "worker/cloudflare.js",
  "compatibility_date": "2025-11-01",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./build/cloudflare",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "pltv-ink-letters"
    }
  ],
  "account_id": "c0a9c396fb77f08c584f0554421688ad"
}
